{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    // "DOM" is required for page.evaluate/waitForFunction callbacks (Task 7+),
    // which reference browser globals like `document` — these are type-checked
    // in this file even though they execute in the browser at runtime.
    "lib": ["ES2022", "DOM"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // The specs shared from pihemr (@pih/pihemr-e2e) are linked, so Node would resolve their "@playwright/test" by their real path and
    // find none or a second copy. This maps it to this repo's copy (playwright.config.ts: `tsconfig`). See pihemr/e2e/README.md.
    "paths": { "@playwright/test": ["./node_modules/@playwright/test"] }
  },
  "include": ["**/*.ts"]
}
